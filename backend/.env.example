# ─── FitMind AI – Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Option 1: Supabase Connection Pooler (Session mode, Port 5432 - Works on all IPv4 & IPv6 networks)
# In Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session Mode:
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=your-supabase-database-password

# Option 2: Supabase Direct Connection (Port 5432 - Requires IPv6 or Supabase IPv4 Add-on)
# In Supabase Dashboard -> Project Settings -> Database -> Connection string -> Direct connection:
# SUPABASE_DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=postgres
# SUPABASE_DB_PASSWORD=your-supabase-database-password

# Option 3: Direct Supabase URI (EnvLoader automatically converts it to JDBC format):
# SUPABASE_DB_URL=postgresql://postgres.<your-project-ref>:your-password@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── JWT Security ─────────────────────────────────────────────────────────────
# Use a strong random secret (minimum 32 characters / 256-bit)
JWT_SECRET=change-this-to-a-random-256-bit-secret-key-in-production
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
AI_API_KEY=your-google-gemini-api-key
AI_ENABLED=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
